---
import { SEO as BaseSEO } from 'astro-seo';
import type { SeoProps } from '../types/seo-props';
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION } from '../util/site';
import { getImageMeta } from '../util/image-meta';
import { DEFAULT_OG_IMAGE } from '../util/og-image';

interface Props {
  seo?: SeoProps;
}

const {
  baseUrl = SITE_URL,
  description = SITE_DESCRIPTION,
  keywords = [
    'emanuel zaveruka',
    'análise de sistemas',
    'engenharia de software',
    'bdd',
    'mapeamento de processos',
    'ia no dia a dia',
    'portfólio',
    'blog'
  ],
  urlPath = '/',
  title = `${SITE_NAME} — Análise de sistemas, processos e IA na prática`,
  imagePath = DEFAULT_OG_IMAGE,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  noindex = false
} = Astro.props.seo ?? {};

const fullUrl = new URL(urlPath, baseUrl).toString();
const fullImageUrl = new URL(imagePath, baseUrl).toString();

// Crawlers size the card from these tags before fetching the file; without
// them WhatsApp, LinkedIn and Slack fall back to a small thumbnail — or to no
// image at all.
const imageMeta = getImageMeta(imagePath);
const imageDescription = imageAlt ?? title;

// The home page already carries the full name in its title; inner pages get the
// site suffix so they stay identifiable in search results.
const pageTitle = urlPath === '/' ? title : `${title} · ${SITE_NAME}`;
---

<BaseSEO
  title={pageTitle}
  description={description}
  canonical={fullUrl}
  noindex={noindex}
  openGraph={{
    basic: {
      title,
      type,
      image: fullImageUrl,
      url: fullUrl
    },
    optional: {
      description,
      siteName: SITE_NAME,
      locale: 'pt_BR'
    },
    image: {
      url: fullImageUrl,
      secureUrl: fullImageUrl,
      alt: imageDescription,
      ...(imageMeta && {
        type: imageMeta.type,
        width: imageMeta.width,
        height: imageMeta.height
      })
    },
    ...(type === 'article' && {
      article: {
        publishedTime,
        modifiedTime: modifiedTime ?? publishedTime,
        authors: [SITE_NAME],
        section,
        tags: keywords
      }
    })
  }}
  twitter={{
    card: 'summary_large_image',
    title: pageTitle,
    description,
    image: fullImageUrl,
    imageAlt: imageDescription
  }}
  extend={{
    link: [{ rel: 'alternate', type: 'application/rss+xml', title: SITE_NAME, href: '/rss.xml' }],
    meta: keywords?.length
      ? [
          {
            name: 'keywords',
            content: keywords.join(', ')
          }
        ]
      : []
  }}
/>
