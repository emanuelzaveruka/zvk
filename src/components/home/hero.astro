---
import { Icon } from 'astro-icon/components';
import ProfileImage from '../profile-image.astro';
import { SocialMediaLinks } from '../../util/link/social-media';
import { FOCUS } from './focus';

// Stacked composition: the photo sits above the name at every width. The 32rem
// gutters leave a 415px column from 1280px up, which cannot hold the photo and
// the text side by side.
const LABELS: Record<string, string> = {
  Github: 'GitHub',
  LinkedIn: 'LinkedIn',
  Mail: 'E-mail'
};

const social = Object.keys(LABELS)
  .map((label) => SocialMediaLinks.find((link) => link.label === label))
  .filter((link): link is NonNullable<typeof link> => Boolean(link));
---

<section
  class="mx-auto flex max-w-home flex-col-reverse gap-8 px-5 pb-7 pt-7 md:px-8 lg:px-12 xl:px-[32rem]">
  <div>
    <p class="m-0 text-sm uppercase tracking-[0.2em] text-home-muted">
      Desenvolvedor &amp; analista de sistemas
    </p>

    {/* Capped at 84px: "Zaveruka." measures 4.58em, so anything larger spills
        out of the narrow column the wide gutters leave behind. */}
    <h1
      class="mb-6 mt-3 text-[clamp(2.75rem,7.4vw,5.25rem)] font-extrabold leading-[0.85] tracking-[-0.025em] text-home-text">
      Emanuel<br /><span class="text-home-accent">Zaveruka.</span>
    </h1>

    <p
      class="m-0 text-[1.5rem] font-medium leading-snug tracking-[-0.01em] text-home-text md:text-[1.6875rem]">
      Conecto processos, sistemas e dados.
    </p>

    <p class="m-0 mt-2 max-w-[460px] text-xl leading-[1.45] text-home-muted">
      Desenvolvimento, integrações e automação para resolver problemas reais.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href="#projetos"
        class:list={[
          'inline-flex h-14 items-center rounded-lg bg-home-accent px-7 font-semibold text-home-on-accent no-underline transition-colors hover:bg-[#c2daff]',
          FOCUS
        ]}>
        Ver projetos
      </a>

      <a
        href="/sobre/"
        class:list={[
          'group inline-flex items-center gap-3 text-home-text no-underline transition-colors hover:text-home-accent',
          FOCUS
        ]}>
        Sobre mim
        <Icon
          name="mdi:arrow-right"
          aria-hidden="true"
          class="h-4 w-4 text-home-muted transition-colors group-hover:text-home-accent"
        />
      </a>
    </div>

    <ul class="m-0 mt-7 flex list-none flex-wrap items-center gap-x-8 gap-y-3 p-0 text-base">
      {
        social.map((link) => (
          <li class="p-0">
            <a
              href={link.href}
              class:list={[
                'group inline-flex items-center gap-2 text-home-text no-underline transition-colors hover:text-home-accent',
                FOCUS
              ]}>
              {LABELS[link.label]}
              <Icon
                name="mdi:arrow-top-right"
                aria-hidden="true"
                class="h-3.5 w-3.5 text-home-muted transition-colors group-hover:text-home-accent"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="flex shrink-0 justify-center">
    <ProfileImage
      class="h-36 w-36 md:h-44 md:w-44 lg:h-64 lg:w-64 xl:h-[17.5rem] xl:w-[17.5rem]"
      alt="Retrato de Emanuel Zaveruka"
    />
  </div>
</section>
