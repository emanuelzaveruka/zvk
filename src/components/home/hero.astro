---
import { Icon } from 'astro-icon/components';
import ProfileImage from '../profile-image.astro';
import { SocialMediaLinks } from '../../util/link/social-media';
import { FOCUS } from './focus';

// The three destinations the plan asks for, pulled from the site's real link
// list rather than retyped. Discord stays out of the redesigned home.
const LABELS: Record<string, string> = {
  Github: 'GitHub',
  LinkedIn: 'LinkedIn',
  Mail: 'E-mail'
};

const social = Object.keys(LABELS)
  .map((label) => SocialMediaLinks.find((link) => link.label === label))
  .filter((link): link is NonNullable<typeof link> => Boolean(link));
---

<section
  class="mx-auto flex max-w-home flex-col-reverse gap-10 px-5 pb-12 pt-4 md:px-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:pb-24">
  <div class="lg:max-w-2xl">
    <p class="m-0 text-sm uppercase tracking-[0.18em] text-home-muted">
      Desenvolvedor &amp; analista de sistemas
    </p>

    <h1
      class="mb-6 mt-4 text-[clamp(3rem,9vw,5.5rem)] font-extrabold leading-[1.02] tracking-tight text-home-text">
      Emanuel<br /><span class="text-home-accent">Zaveruka.</span>
    </h1>

    <p class="m-0 text-[1.375rem] leading-snug text-home-text md:text-[1.75rem]">
      Conecto processos, sistemas e dados.
    </p>

    <p class="mb-9 mt-4 max-w-xl text-base leading-relaxed text-home-muted md:text-lg">
      Desenvolvimento, integrações e automação para resolver problemas reais.
    </p>

    <div class="flex flex-wrap items-center gap-x-8 gap-y-5">
      <a
        href="#projetos"
        class:list={[
          'inline-flex min-h-[44px] items-center rounded-md bg-home-accent px-6 py-3 font-semibold text-home-on-accent no-underline transition-colors hover:bg-[#c2daff]',
          FOCUS
        ]}>
        Ver projetos
      </a>

      <ul class="m-0 flex list-none flex-wrap items-center gap-x-6 gap-y-3 p-0 text-sm">
        {
          social.map((link) => (
            <li class="p-0">
              <a
                href={link.href}
                class:list={[
                  'inline-flex min-h-[44px] items-center gap-2 text-home-muted no-underline transition-colors hover:text-home-accent',
                  FOCUS
                ]}>
                <Icon name={link.icon} aria-hidden="true" class="h-[1.05rem] w-[1.05rem]" />
                {LABELS[link.label]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="flex justify-center lg:justify-end">
    <ProfileImage
      class="h-32 w-32 md:h-40 md:w-40 lg:h-64 lg:w-64"
      alt="Retrato de Emanuel Zaveruka"
    />
  </div>
</section>
