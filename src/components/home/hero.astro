---
import { Icon } from 'astro-icon/components';
import ProfileImage from '../profile-image.astro';
import { SocialMediaLinks } from '../../util/link/social-media';
import { FOCUS } from './focus';

// Type sizes and gaps are measured off the reference render: name cap height
// 67px (≈92px type) on a 74px line, one-line lead sentence at 500px, social
// row 32px under a 48px button.
const LABELS: Record<string, string> = {
  Github: 'GitHub',
  LinkedIn: 'LinkedIn',
  Mail: 'E-mail'
};

const social = Object.keys(LABELS)
  .map((label) => SocialMediaLinks.find((link) => link.label === label))
  .filter((link): link is NonNullable<typeof link> => Boolean(link));
---

<section
  class="mx-auto flex max-w-home flex-col-reverse gap-10 px-5 pb-5 pt-7 md:px-8 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
  <div class="lg:max-w-[540px]">
    <p class="m-0 text-[0.85rem] uppercase tracking-[0.2em] text-home-muted">
      Desenvolvedor &amp; analista de sistemas
    </p>

    <h1
      class="mb-6 mt-3 text-[clamp(3rem,7.4vw,5.75rem)] font-extrabold leading-[0.8] tracking-[-0.025em] text-home-text">
      Emanuel<br /><span class="text-home-accent">Zaveruka.</span>
    </h1>

    <p
      class="m-0 max-w-[540px] text-[1.5rem] font-medium leading-snug tracking-[-0.01em] text-home-text md:text-[1.75rem]">
      Conecto processos, sistemas e dados.
    </p>

    <p class="m-0 mt-2 max-w-[430px] text-[1.1875rem] leading-[1.4] text-home-muted">
      Desenvolvimento, integrações e automação para resolver problemas reais.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href="#projetos"
        class:list={[
          'inline-flex h-12 items-center rounded-md bg-home-accent px-6 font-semibold text-home-on-accent no-underline transition-colors hover:bg-[#c2daff]',
          FOCUS
        ]}>
        Ver projetos
      </a>

      <a
        href="/sobre/"
        class:list={[
          'group inline-flex items-center gap-3 text-home-text no-underline transition-colors hover:text-home-accent',
          FOCUS
        ]}>
        Sobre mim
        <Icon
          name="mdi:arrow-right"
          aria-hidden="true"
          class="h-4 w-4 text-home-muted transition-colors group-hover:text-home-accent"
        />
      </a>
    </div>

    <ul class="m-0 mt-7 flex list-none flex-wrap items-center gap-x-8 gap-y-3 p-0 text-[0.9375rem]">
      {
        social.map((link) => (
          <li class="p-0">
            <a
              href={link.href}
              class:list={[
                'group inline-flex items-center gap-2 text-home-text no-underline transition-colors hover:text-home-accent',
                FOCUS
              ]}>
              {LABELS[link.label]}
              <Icon
                name="mdi:arrow-top-right"
                aria-hidden="true"
                class="h-3.5 w-3.5 text-home-muted transition-colors group-hover:text-home-accent"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="flex justify-center lg:mr-4 lg:mt-[15px] lg:justify-end">
    <ProfileImage
      class="h-36 w-36 md:h-44 md:w-44 lg:h-[17.5rem] lg:w-[17.5rem]"
      alt="Retrato de Emanuel Zaveruka"
    />
  </div>
</section>
