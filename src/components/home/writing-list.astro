---
import { indexablePosts } from '../../util/get-post';
import SectionHeading from './section-heading.astro';
import WritingRow from './writing-row.astro';

// `indexablePosts` is already sorted newest first and holds only fully
// published posts, so drafts and `preview` posts can't surface here.
const latest = indexablePosts.slice(0, 2);
---

{
  latest.length > 0 && (
    <section id="escritos" class="mx-auto max-w-home scroll-mt-6 px-5 pb-4 pt-4 md:px-8">
      <SectionHeading index="02" title="Escritos" href="/blog/" linkLabel="Todos os textos" />

      <ul class="m-0 mt-5 list-none p-0">
        {latest.map((post) => (
          <li class="p-0">
            <WritingRow post={post} />
          </li>
        ))}
      </ul>
    </section>
  )
}
