---
import projects from '../../data/project.json';
import ProjectTile from './project-tile.astro';
import SectionHeading from './section-heading.astro';

// Two in focus, from the site's own project data. There is no projects index
// page, so the plan's `Todos os projetos` link has no destination and is left
// out rather than pointed at a placeholder.
const featured = projects.slice(0, 2);
---

{
  featured.length > 0 && (
    <section id="projetos" class="mx-auto max-w-home scroll-mt-6 px-5 py-10 md:px-8 md:py-20">
      <SectionHeading index="01" title="Projetos selecionados" />

      <ul class="m-0 mt-8 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2">
        {featured.map((project) => (
          <li class="p-0">
            <ProjectTile project={project} />
          </li>
        ))}
      </ul>
    </section>
  )
}
