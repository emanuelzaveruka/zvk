---
import projects from '../../data/project.json';
import ProjectTile from './project-tile.astro';
import SectionHeading from './section-heading.astro';

// Two in focus, from the site's own project data. There is no projects index
// page, so `Todos os projetos` points at the GitHub profile the site already
// links to, rather than at a page that doesn't exist.
const featured = projects.slice(0, 2);
const allProjects = 'https://github.com/emanuelzaveruka?tab=repositories';
---

{
  featured.length > 0 && (
    <section id="projetos" class="mx-auto max-w-home scroll-mt-6 px-5 py-10 md:px-8 md:py-16">
      <SectionHeading
        index="01"
        title="Projetos selecionados"
        href={allProjects}
        linkLabel="Todos os projetos"
        external
      />

      <ul class="m-0 mt-8 grid list-none grid-cols-1 gap-5 p-0 md:grid-cols-2">
        {featured.map((project) => (
          <li class="p-0">
            <ProjectTile project={project} />
          </li>
        ))}
      </ul>
    </section>
  )
}
