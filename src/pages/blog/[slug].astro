---
import type { CollectionEntry } from 'astro:content';

import Document from '../../layouts/document.astro';

import PostHeader from '../../components/post-header.astro';
import Section from '../../components/section.astro';
import { posts, isIndexable, postPath } from '../../util/get-post';
import { ogImage } from '../../util/og-image';
import { SITE_URL, SITE_LOCALE } from '../../util/site';

export async function getStaticPaths() {
  // `posts` already drops drafts outside dev, so they never reach the sitemap.
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const published = new Date(post.data.date);
const updated = post.data.updated ? new Date(post.data.updated) : published;

const urlPath = postPath(post.slug);
const canonical = new URL(urlPath, SITE_URL).toString();

// The share card is the 1200x630 derivative when one has been generated for
// this slug; the post's own illustration is the fallback.
const sharePath = ogImage(post.slug) ?? post.data.image;
const imageUrl = sharePath ? new URL(sharePath, SITE_URL).toString() : undefined;

const schema = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: canonical,
  datePublished: published.toISOString(),
  dateModified: updated.toISOString(),
  inLanguage: SITE_LOCALE,
  keywords: post.data.keywords,
  wordCount: post.body.trim().split(/\s+/).length,
  author: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#person` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  ...(imageUrl && { image: imageUrl })
};

const { Content } = await post.render();
---

<Document
  schema={schema}
  seo={{
    title: post.data.title,
    description: post.data.description,
    keywords: post.data.keywords,
    urlPath,
    imagePath: sharePath,
    imageAlt: post.data.title,
    type: 'article',
    publishedTime: published.toISOString(),
    modifiedTime: updated.toISOString(),
    section: post.data.keywords[0],
    noindex: !isIndexable(post)
  }}>
  <PostHeader date={published} post={post} />

  <Section class='md'>
    <Content />
  </Section>

  <nav class='w-full max-w-3xl pb-10 text-center'>
    <a href='/blog/' rel='up'>&larr; Ver todos os posts</a>
  </nav>
</Document>

<style is:global lang='scss'>
  .md {
    pre {
      @apply font-mono p-4 rounded-md;
      font-family: 'Cascadia Code', Consolas, monaco, monospace !important;
      font-variant-ligatures: common-ligatures !important;
    }

    :not(pre) > code {
      @apply bg-neutral-800 p-1 rounded-md font-normal text-blue-100;
      font-family: 'Cascadia Code', Consolas, monaco, monospace !important;
      font-variant-ligatures: common-ligatures !important;
    }

    a[href] {
      @apply font-normal no-underline hover:underline;
    }

    blockquote {
      @apply font-normal not-italic;
    }

    img {
      @apply mx-auto h-auto max-w-full;
    }

    /* Wide tables scroll inside their own wrapper instead of stretching the
       page. The wrapper comes from rehype-post-tables; `min-w-full` keeps the
       table spanning the prose column when it fits, `w-max` lets it grow past
       it when it doesn't, and only the wrapper scrolls. */
    .table-scroll {
      @apply my-8 overflow-x-auto;

      table {
        @apply my-0 w-max min-w-full;
      }

      &:focus-visible {
        @apply outline outline-2 outline-offset-2 outline-neutral-500;
      }
    }

    /* Illustrations: `![alt](/images/... 'Caption')` becomes figure + caption
       through the rehype plugin, so captions read as captions and not prose. */
    figure {
      @apply my-10;

      img {
        @apply rounded-lg border border-neutral-800 w-full;
      }

      figcaption {
        @apply text-center text-sm not-italic text-neutral-400 mt-3;
      }
    }
  }
</style>
