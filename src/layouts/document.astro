---
import Footer from '../components/footer.astro';
import '../style/global.css';
import Seo from '../components/seo.astro';
import type { SeoProps } from '../types/seo-props';
import MainNav from '../components/main-nav.astro';
import { SocialMediaLinks } from '../util/link/social-media';
import { SITE_NAME, SITE_URL, SITE_LOCALE, SITE_EMAIL } from '../util/site';

interface Props {
  seo?: SeoProps;
  header?: boolean;
  headerClass?: string;
  class?: string;
  light?: boolean;
  mainClass?: string;
  footer?: boolean;
  /** Extra classes on <body>, for a page with its own background. */
  bodyClass?: string;
  /** Full-bleed: drops the centering wrapper so a page can own its layout. */
  bare?: boolean;
  /** Extra JSON-LD node (e.g. a BlogPosting) merged into the page @graph. */
  schema?: Record<string, unknown>;
}

const {
  seo,
  header = true,
  footer = true,
  light,
  schema,
  bodyClass,
  bare = false,
  mainClass,
  headerClass = '!text-sm !font-normal'
} = Astro.props;

// `sameAs` links let search engines tie this page to the same real-world entity
// across profiles, which is what makes the Person node worth emitting at all.
const profileUrls = SocialMediaLinks.map((link) => link.href).filter((href) =>
  href.startsWith('http')
);

const person = {
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: SITE_NAME,
  jobTitle: 'Analista de Sistemas',
  url: SITE_URL,
  email: SITE_EMAIL,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Curitiba',
    addressRegion: 'PR',
    addressCountry: 'BR'
  },
  nationality: 'Brazilian',
  sameAs: profileUrls
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE_NAME,
  inLanguage: SITE_LOCALE,
  publisher: { '@id': `${SITE_URL}/#person` }
};

const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [person, website, ...(schema ? [schema] : [])]
});
---

<!doctype html>
<html lang={SITE_LOCALE} class={light ? "light" : "dark"}>
  <head>
    <!-- Simple meta -->
    <meta name="theme-color" content="#000000" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <!-- General SEO -->
    <script is:inline type="application/ld+json" set:html={ldJson} />
    <link rel="manifest" href="/manifest.json" />

    <!-- Icons -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/favicon-96x96-96x96.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-96x96.png"
    />
    <link
      rel="shortcut icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-96x96.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-96x96.png"
    />
    <link
      rel="shortcut icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-96x96.png"
    />

    {/* Poppins is self-hosted through @fontsource in global.css — no external
        stylesheet round-trip before first paint. */}

    <Seo seo={seo} />

    <slot name="head" />
  </head>

  <body
    class:list={[
      'antialiased flex w-full flex-col justify-center items-center tracking-tight dark:bg-neutral-900 dark:text-neutral-50 min-h-screen',
      bodyClass
    ]}
  >
    {
      /* `bare` hands the page the full viewport width, with no prose wrapper
         and no fixed icon nav. Only the redesigned home asks for it; every
         other page renders exactly the markup it did before. */
      bare ? (
        <main class:list={['w-full', mainClass]}>
          <slot />
        </main>
      ) : (
        <div class="flex justify-start items-start max-w-prose:flex-col-reverse">
          <main
            class:list={[
              "flex flex-col items-center justify-center gap-5 p-5 h-full",
              Astro.props.class,
            ] }
          >
            <slot />
          </main>
          {header && <MainNav class={headerClass} />}
        </div>
      )
    }
    {footer && <Footer />}
  </body>
</html>

<style is:global>
  /* Support for flag emojis */
  @font-face {
    font-family: "Twemoji Country Flags";
    unicode-range: U+1F1E6-1F1FF, U+1F3F4, U+E0062-E0063, U+E0065, U+E0067,
      U+E006C, U+E006E, U+E0073-E0074, U+E0077, U+E007F;
    src: url("https://cdn.jsdelivr.net/npm/country-flag-emoji-polyfill/dist/TwemojiCountryFlags.woff2")
      format("woff2");
    font-display: swap;
  }
</style>
